{
  "name": "openmaic",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"../../public/vendor/interactive","binding":"INTERACTIVE_LIBRARIES","run_worker_first":true},
  "vars": {
    "COMPUTE_POOL": "production-2",
    "PRODUCT_NAME": "OpenMAIC",
    "PUBLIC_ORIGIN": "https://openmaic.g-kahriman078.workers.dev",
    "SUPABASE_URL": "https://nqwgpkatevanbhiutetz.supabase.co",
    "POOL_URL": "postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres",
    "DAILY_CALLS": "100", "GLOBAL_DAILY_CALLS": "600"
  },
  "r2_buckets": [{"binding":"FILES","bucket_name":"openmaic-private-assets"}],
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"Classroom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["Classroom"]}],
  "containers": [{"class_name":"Classroom","image":"registry.cloudflare.com/624219bc02ce67c5573efba0c091f73b/openmaic-product:1cf2b534fdbefe82","instance_type":"standard-2","max_instances":6}],
  "ratelimits":[
    {"name":"AUTH_LIMIT","namespace_id":"65301","simple":{"limit":12,"period":60}},
    {"name":"APP_LIMIT","namespace_id":"65302","simple":{"limit":100,"period":60}}
  ],
  "observability":{"enabled":true,"logs":{"invocation_logs":false}}
}
